    },
    "It will replace the DLLs used by CrossOver with ones that match your compatibility tool." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il remplacera les DLL utilisées par CrossOver par des DLL qui correspondent à votre outil de compatibilité."
          }
        },
        "it" : {
          "stringUnit" : {
