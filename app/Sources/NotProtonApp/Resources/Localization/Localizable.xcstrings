        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装失败"
          }
        }
      }
    },
    "The installed build record is invalid." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les informations de la version installée ne sont pas valides."
          }
