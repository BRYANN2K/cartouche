        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "图形后端更新源不可用。已安装的后端未更改。"
          }
        }
      }
    },
    "The graphics backend update signature could not be verified. Your installed backends are unchanged." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La signature de la mise à jour des moteurs de rendu n’a pas pu être vérifiée. Vos moteurs de rendu installés n’ont pas changé."
