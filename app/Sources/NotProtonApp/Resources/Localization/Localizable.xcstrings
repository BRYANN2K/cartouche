    "Cartouche asks for a permission the first time you use the feature that needs it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche vous demande une autorisation au premier usage de la fonctionnalité concernée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche chiede un permesso la prima volta che usi la funzione che ne ha bisogno."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche 会在你首次使用需要某项权限的功能时请求该权限。"
          }
        }
      }
    },
    "Cartouche can't open at login. Allow it in Login Items in System Settings." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche ne peut pas s’ouvrir à la connexion. Autorisez-le dans Réglages Système > Ouverture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche non può aprirsi al login. Consentilo in Elementi login nelle Impostazioni di Sistema."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche 无法在登录时打开。请在系统设置的“登录项”中允许它。"
          }
        }
      }
    },
    "Cartouche can't press keys for the controller. Allow Accessibility in System Settings." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche ne peut pas simuler les touches avec la manette. Autorisez-le dans Réglages Système > Confidentialité et sécurité > Accessibilité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche non può premere i tasti per il controller. Consenti Accessibilità nelle Impostazioni di Sistema."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche 无法为手柄模拟按键。请在系统设置中允许“辅助功能”。"
          }
        }
      }
    },
    "Cartouche can't read Downloads. Allow it in System Settings." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche ne peut pas accéder au dossier Téléchargements. Autorisez-le dans les Réglages Système."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche non può leggere Download. Consentilo nelle Impostazioni di Sistema."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche 无法读取“下载”文件夹。请在系统设置中允许。"
          }
        }
      }
    },
    "Cartouche can't read the keyboard. Allow Input Monitoring in System Settings." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche ne peut pas détecter les touches du clavier. Autorisez-le dans Réglages Système > Confidentialité et sécurité > Surveillance de l’entrée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche non può leggere la tastiera. Consenti Monitoraggio input nelle Impostazioni di Sistema."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche 无法读取键盘。请在系统设置中允许“输入监控”。"
          }
        }
      }
    },
    "Cartouche can't read this disk. Allow Removable Volumes in System Settings." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche ne peut pas accéder à ce disque. Autorisez l’accès aux volumes amovibles dans Réglages Système > Confidentialité et sécurité > Fichiers et dossiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche non può leggere questo disco. Consenti Volumi rimovibili nelle Impostazioni di Sistema."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche 无法读取此磁盘。请在系统设置中允许“可移除宗卷”。"
          }
        }
      }
    },
    "Cartouche can't use the keychain. Sign in again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche ne peut pas utiliser le trousseau. Connectez-vous à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche non può usare il portachiavi. Accedi di nuovo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche 无法使用钥匙串。请重新登录。"
          }
        }
      }
    },
    "Cartouche can't use the local network. Allow Local Network in System Settings." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche ne peut pas accéder au réseau local. Autorisez-le dans Réglages Système > Confidentialité et sécurité > Réseau local."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche non può usare la rete locale. Consenti Rete locale nelle Impostazioni di Sistema."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche 无法使用本地网络。请在系统设置中允许“本地网络”。"
          }
        }
      }
    },
    "Cartouche cannot use Steam from a folder with a colon in its name." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche ne peut pas utiliser Steam depuis un dossier dont le nom contient deux-points."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche non può usare Steam da una cartella con i due punti nel nome."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche 无法使用名称中含有冒号的文件夹中的 Steam。"
