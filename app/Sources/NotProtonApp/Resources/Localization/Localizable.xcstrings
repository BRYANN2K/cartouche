          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Portachiavi non ha potuto conservare la chiave di contributore. Dopo l’uscita da Cartouche, ciò che hai condiviso non potrà più essere modificato da questo Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "钥匙串无法保存你的贡献者密钥。退出 Cartouche 后，将无法再从此 Mac 修改你分享的内容。"
          }
        }
      }
    },
    "The MCP server entry most clients take" : {
