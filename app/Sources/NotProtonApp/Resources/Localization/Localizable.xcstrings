        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作将删除该游戏的容器。"
          }
        }
      }
    },
    "This will DELETE the prefixes for %lld games." : {
      "localizations" : {
        "fr" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
