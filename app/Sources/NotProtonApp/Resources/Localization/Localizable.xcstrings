        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "游戏已崩溃。其日志保留了回溯信息。"
          }
        }
      }
    },
    "It is in Steam's library too." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il est aussi dans la bibliothèque Steam."
