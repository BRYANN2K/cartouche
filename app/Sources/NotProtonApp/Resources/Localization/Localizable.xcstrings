          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它可能是可选的：校验和文件说明部分分卷为可选下载。"
          }
        }
      }
    },
    "It replaces the cover from Steam until you choose Use the Original Cover." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette image remplace la jaquette Steam. Pour revenir en arrière, choisissez Utiliser la jaquette d’origine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
