    "%@ already exists and could not be used." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ existe déjà et n’a pas pu être utilisé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ esiste già e non è stato possibile usarlo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已存在，无法使用。"
          }
        }
      }
    },
    "%@ and %@ both come from %@ but pin different hashes." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ et %@ proviennent tous les deux de %@, mais imposent des hachages différents."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ e %2$@ vengono entrambi da %3$@ ma fissano hash diversi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 和 %@ 均来自 %@，但指定了不同的哈希值。"
          }
        }
      }
    },
    "%@ artwork" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Illustration de %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immagine di %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的图片"
          }
        }
      }
    },
    "%@ at %@ spans %lld bytes, past the end of a %lld byte file." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ à %@ couvre %lld octets, au-delà de la fin d’un fichier de %lld octets."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a %2$@ occupa %3$lld byte, oltre la fine di un file di %4$lld byte."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ 处的%1$@占用 %3$lld 字节，超出了文件的 %4$lld 字节长度。"
          }
        }
      }
    },
    "%@ average" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ en moyenne"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Media di %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 平均"
          }
        }
      }
    },
    "%@ carries no entitlements to extend." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne contient aucune autorisation à étendre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non ha entitlement da estendere."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不包含可扩展的授权项。"
          }
        }
      }
    },
    "%@ changed since it was installed." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a changé depuis son installation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è cambiato dopo l’installazione."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 在安装后已被更改。"
          }
        }
      }
    },
    "%@ could not be added: %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ could not be added: %2$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’ajouter %@ : %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile aggiungere %1$@: %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法添加 %1$@：%2$@"
          }
        }
      }
    },
    "%@ could not be copied out of the prefix. The prefix has been left as it was and nothing has been lost. Check free space and permissions, then try again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de copier %@ hors du préfixe. Rien n’a été modifié ni perdu. Vérifiez l’espace disponible et les autorisations d’accès, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile copiare %@ fuori dal prefisso. Il prefisso è rimasto com'era e non è andato perso nulla. Controlla lo spazio libero e i permessi, poi riprova."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法从容器中复制 %@。容器保持原样，未丢失任何内容。请检查剩余空间和权限，然后重试。"
          }
        }
      }
    },
    "%@ could not be copied. " : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
