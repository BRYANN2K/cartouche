    "Published under CC0 1.0 once a moderator approves it. No account, Steam ID, path or log is sent. You can edit or withdraw it from My Contributions." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Publié sous CC0 1.0 après validation par un modérateur. Aucun compte, identifiant Steam, chemin ou journal n’est envoyé. Vous pouvez le modifier ou le retirer depuis Mes contributions."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pubblicato con licenza CC0 1.0 dopo l’approvazione di un moderatore. Non vengono inviati account, ID Steam, percorsi o log. Puoi modificarlo o ritirarlo da I miei contributi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "经版主批准后以 CC0 1.0 发布。不会发送任何账户、Steam ID、路径或日志。你可以在“我的贡献”中修改或撤回。"
          }
        }
      }
    },
