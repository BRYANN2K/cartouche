    },
    "The Cartouche site refused this Mac’s contributor key." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le site Cartouche a refusé la clé de contributeur de ce Mac."
