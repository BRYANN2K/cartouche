            "state" : "translated",
            "value" : "代码空隙"
          }
        }
      }
    },
    "The cave is %lld bytes from the hook site, which a relative jump cannot reach." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cave è a %lld byte dal punto di aggancio, troppo lontana per un salto relativo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
