    },
    "Steam stopped the download" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam a arrêté le téléchargement"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam ha interrotto il download"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 停止了下载"
          }
        }
      }
    },
    "Steam uses NotProton." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam utilise NotProton."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam usa NotProton."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 正在使用 NotProton。"
          }
        }
      }
    },
    "Steam uses NotProton. Cartouche replaces it inside Steam. NotProton's app and data stay on this Mac. To switch back, remove Cartouche and install NotProton again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam utilise NotProton. Cartouche le remplace dans Steam. L’app et les données de NotProton restent sur ce Mac. Pour revenir en arrière, supprimez Cartouche et réinstallez NotProton."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam usa NotProton. Cartouche lo sostituisce in Steam. L'app e i dati di NotProton restano su questo Mac. Per tornare indietro, rimuovi Cartouche e installa di nuovo NotProton."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 正在使用 NotProton。Cartouche 会替换 Steam 中的它。NotProton 的应用和数据会保留在这台 Mac 上。若要换回，请移除 Cartouche 并重新安装 NotProton。"
          }
        }
      }
    },
    "Steam was installed by another account on this Mac. Only that account can modify it. Log in to macOS with that account to reinstall Cartouche." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam a été installé par un autre compte sur ce Mac. Seul ce compte peut le modifier. Ouvrez une session macOS avec ce compte pour réinstaller Cartouche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam è stato installato da un altro account su questo Mac e solo quell'account può modificarlo. Accedi a macOS con quell'account per reinstallare Cartouche."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 由这台 Mac 上的其他账户安装，只有该账户可以修改。请登录该账户，重新安装 Cartouche。"
          }
        }
      }
    },
    "Steam was stopped, so start it again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam a été arrêté. Relancez-le."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam è stato chiuso: riavvialo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 已停止，请重新启动。"
          }
        }
      }
    },
    "Steam's installed dylib does not match this account's build record. Finish or repair its installation with the Cartouche app that last installed it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dylib installée de Steam ne correspond pas au registre de version de ce compte. Terminez ou réparez son installation avec l’app Cartouche qui l’a installée en dernier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dylib installata in Steam non corrisponde alla build registrata per questo account. Completa o ripara l'installazione con l'app Cartouche che l'ha installata per ultima."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 中已安装的动态库与当前账户的版本记录不一致。请使用上次执行安装的 Cartouche 应用完成或修复安装。"
          }
        }
      }
    },
    "Steam's shortcuts file could not be read." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier de raccourcis de Steam n’a pas pu être lu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere il file dei collegamenti di Steam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取 Steam 的快捷方式文件。"
          }
        }
      }
    },
    "Steam, for controllers in Steam games" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam, pour les manettes dans les jeux Steam"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam, per i controller nei giochi Steam"
