        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 中的 Cartouche 集成有文件缺失或被修改。请在设置中修复。"
          }
        }
      }
    },
    "Steam’s Cartouche integration needs an update." : {
