    "The decompressor could not get the memory it asked for. It can also mean an archive error on this code." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le décompresseur n’a pas pu obtenir la mémoire nécessaire. Ce code peut aussi indiquer une archive endommagée."
          }
        },
