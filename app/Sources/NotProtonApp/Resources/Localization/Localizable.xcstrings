    },
    "%@ support comes in a later version of Cartouche. You will sign in on %@’s own page, and Cartouche will keep only a login token, in your Keychain." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il supporto di %1$@ arriverà in una versione successiva di Cartouche. Accederai dalla pagina di %2$@ e Cartouche conserverà solo un token di accesso, nel tuo portachiavi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 支持将在 Cartouche 的后续版本中推出。你将在 %@ 自己的页面上登录，Cartouche 只会在你的钥匙串中保存登录令牌。"
          }
        }
      }
    },
