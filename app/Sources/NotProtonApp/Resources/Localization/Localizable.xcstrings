      }
    },
    "Its emulator files move to the Trash: %@." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers de son émulateur sont placés dans la Corbeille : %@."
