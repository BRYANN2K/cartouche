            "state" : "translated",
            "value" : "该游戏的 fuel.json 文件缺失。请验证其文件。"
          }
        }
      }
    },
    "The game’s goggame-%@.info file is missing. Verify its files." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
