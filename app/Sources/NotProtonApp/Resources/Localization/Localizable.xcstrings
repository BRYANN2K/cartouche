    "Is this the Steam game with app ID %@? Cartouche matched it by its name only." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’agit-il du jeu Steam d’identifiant %@ ? Cartouche l’a associé uniquement par son nom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È il gioco Steam con App ID %@? Cartouche l’ha associato solo dal nome."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是 App ID 为 %@ 的 Steam 游戏吗？Cartouche 仅按名称匹配了它。"
          }
        }
      }
    },
    "It closed a few seconds after it started." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeu s’est fermé quelques secondes après son lancement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il gioco si è chiuso pochi secondi dopo l’avvio."
          }
