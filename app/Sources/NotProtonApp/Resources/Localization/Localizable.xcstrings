{
  "sourceLanguage" : "en",
  "strings" : {
    " Cartouche can be deployed, but the CrossOver compatibility tool cannot be installed without a valid license." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Cartouche peut être déployé, mais l’outil de compatibilité CrossOver ne peut pas être installé sans licence valide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Cartouche può essere installato, ma lo strumento di compatibilità di CrossOver non può essere installato senza una licenza valida."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 可以部署 Cartouche，但没有有效许可证时无法安装 CrossOver 兼容工具。"
          }
        }
      }
    },
    " with %@" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " avec %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " con %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（使用 %@）"
          }
        }
      }
    },
    "%@ %@ can’t start Windows games yet. Choose another runner in the game’s setup." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@ ne peut pas encore démarrer les jeux Windows. Choisissez une autre version de Wine dans la configuration du jeu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ non può ancora avviare i giochi Windows. Scegli un altro runner nella configurazione del gioco."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ 目前还无法启动 Windows 游戏。请在该游戏的设置中选择其他运行器。"
          }
        }
      }
    },
    "%@ %@ isn’t available to Steam yet. Steam keeps the previous choice." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@ n’est pas encore disponible pour Steam. Steam garde le choix précédent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@ non è ancora disponibile per Steam. Steam mantiene la scelta precedente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@ 尚无法供 Steam 使用。Steam 会保留之前的选择。"
          }
        }
      }
    },
    "%@ (Launcher)" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (lanceur)"
