    },
    "It may be optional: the checksum file says some parts are optional downloads." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fichier est peut-être facultatif : la liste des sommes de contrôle indique que certains fichiers sont optionnels."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
