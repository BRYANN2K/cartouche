            "value" : "已安装版本的记录无效。"
          }
        }
      }
    },
    "The installed emulator could not be found in Applications." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’émulateur installé est introuvable dans Applications."
          }
