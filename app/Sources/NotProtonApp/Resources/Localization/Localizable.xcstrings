          }
        }
      }
    },
    "Sign in once to see your %@ library here. Games download with %@, an open-source client, and run with the runner you choose." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous une fois pour voir votre bibliothèque %@ ici. Les jeux se téléchargent avec %@, un client open source, et se lancent avec la version de Wine de votre choix."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi una volta per vedere qui la tua libreria %1$@. I giochi si scaricano con %2$@, un client open source, e girano con il runner che scegli."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录一次即可在这里看到你的 %1$@ 游戏库。游戏由开源客户端 %2$@ 下载，并使用你选择的运行器运行。"
          }
        }
      }
    },
    "Sign in once to see your %@ library here. Games then run with the runner you choose." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous une fois pour voir votre bibliothèque %@ ici. Les jeux se lancent ensuite avec la version de Wine de votre choix."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi una volta per vedere qui la tua libreria %@. I giochi poi girano con il runner che scegli."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录一次即可在这里看到你的 %@ 游戏库。游戏随后会使用你选择的运行器运行。"
          }
        }
      }
    },
