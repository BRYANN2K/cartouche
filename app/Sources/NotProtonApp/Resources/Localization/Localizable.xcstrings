        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Steam 游戏库需要 Mac 版 Steam。之后 Windows 游戏会通过 Steam Play，使用你在这里设置的运行器运行。"
