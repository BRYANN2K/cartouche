          "stringUnit" : {
            "state" : "translated",
            "value" : "无法安装运行器。"
          }
        }
      }
    },
    "The runner is not ready yet." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette version de Wine n’est pas encore prête."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
