    "The Cartouche site can’t be reached. Your contributions wait on this Mac." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le site Cartouche est injoignable. Vos contributions attendent sur ce Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
