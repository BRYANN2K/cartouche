        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche 无法使用名称中含有冒号的文件夹中的 Steam。"
          }
        }
      }
    },
    "Cartouche carries no components." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche non contiene componenti."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche 未包含任何组件。"
          }
        }
      }
    },
    "Cartouche checks the files first and runs nothing until you choose Install." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche controlla prima i file e non esegue nulla finché non scegli Installa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche 会先检查文件，在你选择“安装”之前不会运行任何内容。"
          }
        }
      }
    },
    "Cartouche could not download %@. Check your internet connection and try again." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche non è riuscito a scaricare %@. Controlla la connessione a Internet e riprova."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche 无法下载 %@。请检查网络连接后重试。"
          }
