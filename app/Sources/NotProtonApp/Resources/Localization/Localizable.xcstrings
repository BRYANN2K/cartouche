            "value" : "代码空隙距挂钩位置 %lld 字节，超出相对跳转指令的范围。"
          }
        }
      }
    },
    "The clone has no Wine loader at %@." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia non ha un loader di Wine in %@."
          }
