          "stringUnit" : {
            "state" : "translated",
            "value" : "无法应用安装程序的兼容性设置"
          }
        }
      }
    },
    "The installer's compatibility settings were applied" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
