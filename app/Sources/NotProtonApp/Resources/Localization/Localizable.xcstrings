    },
    "An agent claiming to be “%@” (%@)" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un agent se présentant comme « %1$@ » (%2$@)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un agente che dichiara di essere “%1$@” (%2$@)"
          }
        },
