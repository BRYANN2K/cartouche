{
  "sourceLanguage" : "en",
  "strings" : {
    " Cartouche can be deployed, but the CrossOver compatibility tool cannot be installed without a valid license." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Cartouche può essere installato, ma lo strumento di compatibilità di CrossOver non può essere installato senza una licenza valida."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 可以部署 Cartouche，但没有有效许可证时无法安装 CrossOver 兼容工具。"
          }
        }
      }
    },
    " with %@" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " con %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（使用 %@）"
          }
        }
      }
    },
    "%@ (this Mac)" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (questo Mac)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@（这台 Mac）"
          }
        }
      }
    },
    "%@ and %@ both come from %@ but pin different hashes." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ e %2$@ vengono entrambi da %3$@ ma fissano hash diversi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 和 %@ 均来自 %@，但指定了不同的哈希值。"
          }
        }
      }
    },
    "%@ artwork" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immagine di %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的图片"
          }
        }
      }
    },
    "%@ at %@ spans %lld bytes, past the end of a %lld byte file." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a %2$@ occupa %3$lld byte, oltre la fine di un file di %4$lld byte."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ 处的%1$@占用 %3$lld 字节，超出了文件的 %4$lld 字节长度。"
          }
        }
      }
    },
    "%@ average" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Media di %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 平均"
          }
        }
      }
    },
    "%@ carries no entitlements to extend." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non ha entitlement da estendere."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不包含可扩展的授权项。"
          }
        }
      }
    },
    "%@ changed since it was installed." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è cambiato dopo l’installazione."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 在安装后已被更改。"
          }
        }
      }
    },
    "%@ could not be added: %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ could not be added: %2$@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile aggiungere %1$@: %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法添加 %1$@：%2$@"
          }
        }
      }
    },
    "%@ could not be copied out of the prefix. The prefix has been left as it was and nothing has been lost. Check free space and permissions, then try again." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile copiare %@ fuori dal prefisso. Il prefisso è rimasto com'era e non è andato perso nulla. Controlla lo spazio libero e i permessi, poi riprova."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法从容器中复制 %@。容器保持原样，未丢失任何内容。请检查剩余空间和权限，然后重试。"
          }
        }
      }
    },
    "%@ could not be copied. " : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
