          "stringUnit" : {
            "state" : "translated",
            "value" : "已应用安装程序的兼容性设置"
          }
        }
      }
    },
    "The list of valid fixes is older than one already checked." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La liste des correctifs valides est plus ancienne qu’une liste déjà vérifiée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
