          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche 网站拒绝了此 Mac 的贡献者密钥。"
          }
        }
      }
    },
    "The Keychain couldn’t keep your contributor key. After Cartouche quits, what you shared can no longer be edited from this Mac." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
