          "stringUnit" : {
            "state" : "translated",
            "value" : "自称“%1$@”的代理（%2$@）"
          }
        }
      }
    },
    "An assistant connected to Cartouche reads the game's values and helps when you ask. It never presses a button in Hardcore mode." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un assistant connecté à Cartouche peut lire les données du jeu et vous aider à votre demande. Il ne simule aucun appui sur un bouton en mode hardcore."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un assistente collegato a Cartouche legge i valori del gioco e ti aiuta quando lo chiedi. Non preme mai pulsanti in modalità hardcore."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接到 Cartouche 的助手会读取游戏数值，在你需要时提供帮助。在硬核模式下，它绝不会按键。"
          }
        }
      }
    },
    "Another dylib is present." : {
      "localizations" : {
        "fr" : {
