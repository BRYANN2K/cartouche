    "Sent as a proposal under CC0 1.0. Nobody’s setup changes until a moderator publishes it and a player chooses to apply it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyé comme proposition sous CC0 1.0. La configuration de personne ne change tant qu’un modérateur ne l’a pas publié et qu’un joueur ne choisit pas de l’appliquer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inviata come proposta con licenza CC0 1.0. Nessuna configurazione cambia finché un moderatore non la pubblica e un giocatore sceglie di applicarla."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以 CC0 1.0 作为提案发送。在版主发布且玩家选择应用之前，不会更改任何人的设置。"
