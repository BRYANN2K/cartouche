          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有效修复列表比已检查过的列表更旧。"
          }
        }
      }
    },
    "The list of valid fixes is out of date. Connect to the internet to check it again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La liste des correctifs valides est périmée. Connectez-vous à Internet pour la vérifier à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
