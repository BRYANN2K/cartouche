            "value" : "游戏名称将被发送至 Steam。"
          }
        }
      }
    },
    "The graphics backend update feed is unavailable. Your installed backends are unchanged." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La liste des mises à jour des moteurs de rendu est indisponible. Vos moteurs de rendu installés n’ont pas changé."
          }
