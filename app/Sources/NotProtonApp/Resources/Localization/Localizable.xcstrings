    "Cartouche Components" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Componenti di Cartouche"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche 组件"
          }
        }
      }
    },
    "Cartouche adds its tools to the Steam app" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche aggiunge i suoi strumenti all'app Steam"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche 会将其工具添加到 Steam 应用"
          }
        }
      }
    },
    "Cartouche asks for a permission the first time you use the feature that needs it." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche chiede un permesso la prima volta che usi la funzione che ne ha bisogno."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche 会在你首次使用需要某项权限的功能时请求该权限。"
          }
        }
      }
    },
    "Cartouche can't open at login. Allow it in Login Items in System Settings." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche non può aprirsi al login. Consentilo in Elementi login nelle Impostazioni di Sistema."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche 无法在登录时打开。请在系统设置的“登录项”中允许它。"
          }
        }
      }
    },
    "Cartouche can't press keys for the controller. Allow Accessibility in System Settings." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche non può premere i tasti per il controller. Consenti Accessibilità nelle Impostazioni di Sistema."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche 无法为手柄模拟按键。请在系统设置中允许“辅助功能”。"
          }
        }
      }
    },
    "Cartouche can't read Downloads. Allow it in System Settings." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche non può leggere Download. Consentilo nelle Impostazioni di Sistema."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche 无法读取“下载”文件夹。请在系统设置中允许。"
          }
        }
      }
    },
    "Cartouche can't read the keyboard. Allow Input Monitoring in System Settings." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche non può leggere la tastiera. Consenti Monitoraggio input nelle Impostazioni di Sistema."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche 无法读取键盘。请在系统设置中允许“输入监控”。"
          }
        }
      }
    },
    "Cartouche can't read this disk. Allow Removable Volumes in System Settings." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche non può leggere questo disco. Consenti Volumi rimovibili nelle Impostazioni di Sistema."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche 无法读取此磁盘。请在系统设置中允许“可移除宗卷”。"
          }
        }
      }
    },
    "Cartouche can't send reports to MacGamingDB yet, so your frame rates stay on this Mac." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche non può ancora inviare segnalazioni a MacGamingDB, quindi i tuoi frame rate restano su questo Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche 目前还无法向 MacGamingDB 发送报告，因此你的帧率只保存在这台 Mac 上。"
          }
        }
      }
    },
    "Cartouche can't use the keychain. Sign in again." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche non può usare il portachiavi. Accedi di nuovo."
