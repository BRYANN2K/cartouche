        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本的 Cartouche 没有用于校验共享修复的密钥。"
          }
        }
      }
    },
    "This will DELETE the game's prefix." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela SUPPRIMERA le préfixe du jeu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il prefisso del gioco verrà ELIMINATO."
          }
