        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam，用于 Steam 游戏中的手柄"
          }
        }
      }
    },
    "Steam’s Cartouche integration has missing or changed files. Repair it in Settings." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains fichiers de l’intégration de Cartouche à Steam sont manquants ou ont été modifiés. Réparez l’installation dans Réglages > Steam."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’integrazione Cartouche di Steam ha file mancanti o modificati. Riparala nelle impostazioni."
