          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche non è riuscito a scaricare da %@ i file che gli servono. Riprova più tardi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche 无法从 %@ 下载所需文件。请稍后重试。"
          }
        }
      }
    },
    "Cartouche could not reach %@'s servers. Please check your internet connection and try again." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche non è riuscito a raggiungere i server di %@. Controlla la connessione a internet e riprova."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche 无法连接 %@ 服务器。请检查网络连接，然后重试。"
          }
        }
      }
    },
    "Cartouche couldn’t copy itself to %@. Drag it to Applications in Finder." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
