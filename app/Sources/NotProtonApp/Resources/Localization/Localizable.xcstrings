    },
    "Cartouche couldn’t save your library choices: %@" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche non è riuscito a salvare le scelte della libreria: %@"
          }
        },
