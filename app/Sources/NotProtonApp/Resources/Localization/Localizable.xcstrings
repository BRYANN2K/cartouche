    },
    "Cartouche has been partially removed, because Steam at %@ cannot be found. Delete that copy of Steam and reinstall it to fully remove Cartouche." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche a été partiellement supprimé, car Steam dans %@ est introuvable. Supprimez cette copie de Steam et réinstallez-la pour supprimer entièrement Cartouche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche è stato rimosso solo in parte, perché Steam in %@ non si trova. Elimina quella copia di Steam e reinstallala per rimuovere del tutto Cartouche."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche 仅被部分移除，因为找不到位于 %@ 的 Steam。请删除该 Steam 并重新安装，以完全移除 Cartouche。"
          }
        }
      }
    },
    "Cartouche has been removed." : {
      "localizations" : {
