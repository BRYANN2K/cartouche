          "stringUnit" : {
            "state" : "translated",
            "value" : "副本的 %@ 处没有 Wine 加载器。"
          }
        }
      }
    },
    "The cloned Wine loader at %@ does not match build %@. Expected %@, found %@." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il loader di Wine copiato in %1$@ non corrisponde alla build %2$@. Atteso %3$@, trovato %4$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "复制到 %@ 的 Wine 加载器与构建版本 %@ 不匹配。预期为 %@，实际为 %@。"
          }
        }
      }
    },
    "The compatibility tool was not set up because CrossOver is not activated." : {
