      }
    },
    "Its emulator files move to the Trash: %@. Its %lld games are hidden and their files stay on disk." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Its emulator files move to the Trash: %1$@. Its %2$lld games are hidden and their files stay on disk."
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Les fichiers de son émulateur sont placés dans la Corbeille : %@. %lld jeu est masqué et ses fichiers restent sur le disque."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Les fichiers de son émulateur sont placés dans la Corbeille : %@. Ses %lld jeux sont masqués et leurs fichiers restent sur le disque."
                }
              }
            }
          }
        },
        "it" : {
          "stringUnit" : {
