          "stringUnit" : {
            "state" : "translated",
            "value" : "安装此游戏的运行器已不再可用。"
          }
        }
      }
    },
    "The runner update feed is unavailable. Your installed runners are unchanged." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le flux de mise à jour des runners est indisponible. Vos runners installés restent inchangés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il feed di aggiornamento dei runner non è disponibile. I runner installati restano invariati."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "运行器更新源不可用。已安装的运行器保持不变。"
          }
        }
      }
    },
    "The runner update signature could not be verified. Your installed runners are unchanged." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La signature de mise à jour des runners n’a pas pu être vérifiée. Vos runners installés restent inchangés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile verificare la firma dell’aggiornamento. I runner installati restano invariati."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法验证运行器更新签名。已安装的运行器保持不变。"
          }
        }
      }
    },
    "The sign-in left no login token." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun jeton de connexion n’a été reçu."
