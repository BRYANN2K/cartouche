        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche 无法使用钥匙串。请重新登录。"
          }
        }
      }
    },
    "Cartouche can't use the local network. Allow Local Network in System Settings." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche non può usare la rete locale. Consenti Rete locale nelle Impostazioni di Sistema."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche 无法使用本地网络。请在系统设置中允许“本地网络”。"
          }
        }
      }
    },
    "Cartouche cannot use Steam from a folder with a colon in its name." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche non può usare Steam da una cartella con i due punti nel nome."
