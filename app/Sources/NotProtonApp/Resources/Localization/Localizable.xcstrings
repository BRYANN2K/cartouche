    "Rebuilt %lld prefixes. Each original is kept beside the game's prefix. Check that your saves are present in the games, then delete the backups to save space." : {
      "localizations" : {
        "fr" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld préfixe reconstruit. Chaque original est conservé à côté du préfixe du jeu. Vérifiez que vos sauvegardes sont présentes dans les jeux, puis supprimez les sauvegardes des préfixes pour gagner de la place."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld préfixes reconstruits. Chaque original est conservé à côté du préfixe du jeu. Vérifiez que vos sauvegardes sont présentes dans les jeux, puis supprimez les sauvegardes des préfixes pour gagner de la place."
                }
              }
            }
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricostruiti %lld prefissi. Ogni originale è conservato accanto al prefisso del gioco. Controlla che i salvataggi siano presenti nei giochi, poi elimina i backup per liberare spazio."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已重建 %lld 个游戏容器。各原容器均保存在对应游戏容器旁。请先进入游戏确认存档正常，再删除备份以释放空间。"
          }
        }
      }
    },
