    "Betas get new features first and may have more bugs. Turning this off keeps the beta until the next release." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les versions bêta permettent de découvrir les nouveautés en avance, mais peuvent contenir davantage de bugs. Si vous désactivez cette option, la bêta reste installée jusqu’à la prochaine version stable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le beta ricevono prima le novità e possono avere più bug. Disattivando l'opzione, la beta resta fino alla prossima versione."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "测试版会先获得新功能，但可能有更多错误。关闭此选项后，测试版会保留到下一个正式版本。"
          }
        }
      }
    },
