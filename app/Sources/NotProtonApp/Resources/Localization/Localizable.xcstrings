          "stringUnit" : {
            "state" : "translated",
            "value" : "游戏启动几秒后就关闭了。"
          }
        }
      }
    },
    "It crashed. Its log keeps the backtrace." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeu a planté. Son journal conserve la trace de la pile."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il gioco si è arrestato in modo anomalo. Il suo log conserva il backtrace."
