        }
      }
    },
    "The installed emulator could not be opened." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’ouvrir l’émulateur installé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile aprire l’emulatore installato."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法打开已安装的模拟器。"
          }
        }
      }
    },
    "The installer quit right after unpacking its helper programs, before showing its first page. A helper the runner could not load is the most likely cause." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le programme d’installation a quitté juste après avoir décompressé ses programmes auxiliaires, avant d’afficher sa première page. Un auxiliaire que la version de Wine n’a pas pu charger est la cause la plus probable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il programma di installazione si è chiuso subito dopo aver decompresso i programmi di supporto, prima di mostrare la prima pagina. La causa più probabile è un programma di supporto che il runner non è riuscito a caricare."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装程序在解压辅助程序后、显示第一个页面之前退出，最可能的原因是运行器无法加载某个辅助程序。"
          }
        }
      }
    },
    "The installer seems stuck." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le programme d’installation semble bloqué."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il programma di installazione sembra bloccato."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装程序似乎卡住了。"
          }
        }
      }
    },
    "The installer uses Inno Setup %@, above what innoextract reads. It runs in Guided mode only." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce programme d’installation utilise Inno Setup %@, une version trop récente pour innoextract. Seul le mode guidé est disponible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il programma di installazione usa Inno Setup %@, oltre quanto innoextract può leggere. Funziona solo in modalità Guidata."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装程序使用 Inno Setup %@，超出 innoextract 可读取的范围。仅能以引导模式运行。"
          }
        }
      }
    },
    "The installer window opens so you can pick languages and options." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fenêtre du programme d’installation s’ouvre pour que vous puissiez choisir langues et options."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si apre la finestra di installazione per scegliere lingue e opzioni."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将打开安装程序窗口，供你选择语言和选项。"
          }
        }
      }
    },
    "The installer's Visual C++ and DirectX packages are replaced by their Wine versions. Your Mac stays awake until it's done." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les paquets Visual C++ et DirectX du programme d’installation sont remplacés par leurs versions Wine. Votre Mac reste éveillé jusqu’à la fin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I pacchetti Visual C++ e DirectX del programma di installazione vengono sostituiti dalle loro versioni per Wine. Il Mac resta attivo fino al termine."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装程序自带的 Visual C++ 和 DirectX 软件包将由对应的 Wine 版本替代。完成前 Mac 不会进入睡眠。"
          }
        }
      }
    },
    "The installer's compatibility settings could not be applied" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réglages de compatibilité du programme d’installation n’ont pas pu être appliqués"
