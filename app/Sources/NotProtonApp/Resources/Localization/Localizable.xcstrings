            "state" : "translated",
            "value" : "运行器尚未就绪。"
          }
        }
      }
    },
    "The runner that installed the game is not set up anymore." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La version de Wine utilisée pour installer le jeu n’est plus configurée."
          }
        },
