    "A copy goes into Cartouche’s games folder, %@. The original is not touched." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une copie est créée dans le dossier de jeux de Cartouche, %@. L’original reste inchangé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una copia va nella cartella dei giochi di Cartouche, %@. L’originale non viene toccato."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "副本会放入 Cartouche 的游戏文件夹，%@。原文件不会改动。"
          }
        }
      }
    },
    "A copy needs %@ on disk and keeps working after the original is removed. Use in Place reads it where it is." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copie occupe %@ sur le disque et fonctionne même si vous supprimez l’original. « Utiliser sans copier » lance le jeu depuis son emplacement actuel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una copia richiede %@ su disco e continua a funzionare anche se l'originale viene rimosso. Usa sul posto la legge dove si trova."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拷贝需要 %@ 磁盘空间，即使移除原件也能继续使用。就地使用则直接读取其当前位置。"
          }
        }
      }
    },
    "A copy needs %@ on disk. The disk image goes away on eject, so it is always copied." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copie occupe %@ sur le disque. Le jeu doit être copié, car l’image disque n’est plus accessible après son éjection."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una copia richiede %@ su disco. L'immagine disco scompare all'espulsione, quindi viene sempre copiata."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拷贝需要 %@ 磁盘空间。磁盘映像在推出后会消失，因此始终会进行拷贝。"
          }
        }
      }
    },
