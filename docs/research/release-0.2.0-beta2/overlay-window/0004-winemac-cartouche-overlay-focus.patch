+        /* Cartouche: its in-game menu takes the focus for a moment. Like a permission dialog,
+         * the game must not see it as a switch away, or a fullscreen game minimizes itself.
+         * The cursor is set free while the menu is open and clipped again after. */
+        [dnc addObserverForName:CartoucheOverlayWillOpenNotification
+                         object:[NSString stringWithFormat:@"%d", getpid()]
+                          queue:[NSOperationQueue mainQueue]
+                     usingBlock:^(NSNotification *note){
+            ++cartoucheGeneration;
+            NSLog(@"cartouche overlay: willOpen active=%d ignoring=%d clipping=%d", [NSApp isActive], temporarilyIgnoreResignEventsForDialog, self.clippingCursor);
+            if (![NSApp isActive] || temporarilyIgnoreResignEventsForDialog) return;
+            cartoucheClipRestore = self.clippingCursor;
+            if (cartoucheClipRestore)
+            {
+                cartoucheClipRect = clipCursorHandler.cursorClipRect;
+                [self stopClippingCursor];
+            }
+            [nc postNotificationName:WineWillShowPermissionDialogNotification object:nil];
+        }];
+
+        [dnc addObserverForName:CartoucheOverlayDidCloseNotification
+                         object:[NSString stringWithFormat:@"%d", getpid()]
+                          queue:[NSOperationQueue mainQueue]
+                     usingBlock:^(NSNotification *note){
+            NSUInteger generation = ++cartoucheGeneration;
+            NSLog(@"cartouche overlay: didClose active=%d ignoring=%d", [NSApp isActive], temporarilyIgnoreResignEventsForDialog);
+            if (!temporarilyIgnoreResignEventsForDialog) return;
+            /* The menu gives the focus back to the game. macOS may refuse Cartouche's request or
+             * hand the front to another app as Cartouche hides; the game takes it back itself */
+            if (![NSApp isActive])
+                [[NSRunningApplication currentApplication] activateWithOptions:NSApplicationActivateIgnoringOtherApps];
+            /* The menu's windows leave and focus settles for a moment after the close: a resign
+             * in that time is still the menu's, not the user switching away */
+            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 250 * NSEC_PER_MSEC), dispatch_get_main_queue(), ^{
+                if (generation != cartoucheGeneration || !temporarilyIgnoreResignEventsForDialog) return;
+                NSLog(@"cartouche overlay: reclaim active=%d", [NSApp isActive]);
+                if (![NSApp isActive])
+                    [[NSRunningApplication currentApplication] activateWithOptions:NSApplicationActivateIgnoringOtherApps];
+            });
+            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 700 * NSEC_PER_MSEC), dispatch_get_main_queue(), ^{
+                if (generation != cartoucheGeneration || !temporarilyIgnoreResignEventsForDialog) return;
+                NSLog(@"cartouche overlay: settled active=%d", [NSApp isActive]);
+                [nc postNotificationName:WineDidShowPermissionDialogNotification object:nil];
+                if (cartoucheClipRestore)
+                {
+                    cartoucheClipRestore = FALSE;
+                    [self startClippingCursor:cartoucheClipRect];
+                }
+                if (![NSApp isActive]) [self applicationDidResignActive:nil];
+            });
+        }];
