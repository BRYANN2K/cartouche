    "Cartouche finds %@ in Applications and starts them with their own settings. It never changes those settings." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche trouve %@ dans Applications et les lance avec leurs propres réglages. Il ne modifie jamais ces réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche trova %@ in Applicazioni e li avvia con le loro impostazioni. Non modifica mai queste impostazioni."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche 会在“应用程序”中找到 %@，并以它们自己的设置启动。Cartouche 从不更改这些设置。"
          }
        }
      }
    },
