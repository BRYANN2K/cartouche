    "RetroArch is free software under the GPL-3.0, built by Cartouche from its source code." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroArch è software libero con licenza GPL-3.0, compilato da Cartouche dal suo codice sorgente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroArch 是采用 GPL-3.0 许可的自由软件，由 Cartouche 从源代码构建。"
          }
        }
      }
    },
    "RetroArch is not there." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroArch non è presente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到 RetroArch。"
          }
        }
      }
    },
    "RetroArch sends a picture of the game to this address and shows the translation it gets back. Use a service you trust: it sees your screen." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroArch invia un'immagine del gioco a questo indirizzo e mostra la traduzione ricevuta. Usa un servizio di cui ti fidi: vede il tuo schermo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroArch 会将游戏画面发送到此地址，并显示返回的翻译。请使用你信任的服务：它能看到你的屏幕。"
          }
        }
      }
    },
    "RetroArch's default" : {
      "localizations" : {
