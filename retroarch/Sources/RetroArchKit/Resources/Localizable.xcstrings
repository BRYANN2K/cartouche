    "%@ quit at once (exit code %d)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ quit at once (exit code %2$d)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ si è chiuso subito (codice di uscita %2$d)."
          }
