        }
      }
    },
    "%@ is already running. Quit the open %@ first." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is already running. Quit the open %2$@ first."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ est déjà en cours d’exécution. Quittez d’abord le %2$@ ouvert."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ è già in esecuzione. Chiudi prima il %2$@ aperto."
