    "RetroArch is free software under the GPL-3.0, built by Cartouche from its source code." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroArch est un logiciel libre sous licence GPL-3.0, compilé par Cartouche à partir de son code source."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroArch è software libero con licenza GPL-3.0, compilato da Cartouche dal suo codice sorgente."
          }
